@Metadata.layer: #CUSTOMER

@UI.headerInfo: { typeName: 'Rating', typeNamePlural: 'Ratings', title.value: 'Rating', description.value: 'UserName' }

@UI.presentationVariant: [ { sortOrder: [ { by: 'RatingDate', direction: #DESC },
                                          { by: 'UserName',   direction: #ASC  } ] } ]

annotate entity ZC_39_RatingTP
  with

{
  /* Facets */
  @UI.facet: [ { position: 10, type: #FIELDGROUP_REFERENCE, label: 'Rating Details',      targetQualifier: 'Details' },
               { position: 20, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', targetQualifier: 'Admin'   } ]

  /* Fields */
  @UI.fieldGroup: [ { position: 10, qualifier: 'Admin' } ]
  RatingUuid;

  @UI.fieldGroup: [ { position: 20, qualifier: 'Admin' } ]
  MovieUuid;

  @UI.fieldGroup: [ { position: 10, qualifier: 'Details' } ]
  @UI.lineItem: [ { position: 10 } ]
  UserName;

  @UI.fieldGroup: [ { position: 20, qualifier: 'Details' } ]
  @UI.lineItem: [ { position: 99 } ]
  Rating;

  @UI.fieldGroup: [ { position: 30, qualifier: 'Admin' } ]
  @UI.lineItem: [ { position: 20 } ]
  RatingDate;
}